<div class="layout layout--col">
  {%- if rankings.size > 0 -%}
    <div class="columns" data-overflow-max-cols="2">
      <div class="column">
        {% for row in rankings %}
          {% render "ranking_row", row: row, show_flag: show_flag, highlight_nation: highlight_nation %}
        {% endfor %}
      </div>
    </div>
    {% render "next_races", events: upcoming, trmnl: trmnl %}
  {%- else -%}
    {% render "empty_state" %}
  {%- endif -%}
</div>
{% render "title_bar", instance_text: discipline_short, concise: true %}